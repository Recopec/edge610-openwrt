# OpenWrt's EFI/combined template locates the kernel with
#   search -l kernel -s root
# i.e. by FAT label, across every attached disk. Two disks written from the
# same image both carry the label 'kernel', so whichever enumerates first
# supplies /boot/vmlinuz - a stick can boot the eMMC's kernel. Search by the
# boot partition's own filesystem UUID instead; edge610-install gives the
# target a fresh serial and rewrites this line to match. 1234-ABCD is the
# serial mkfs.fat --invariant puts in every image built here.
diff --git a/target/linux/x86/image/grub-efi.cfg b/target/linux/x86/image/grub-efi.cfg
--- a/target/linux/x86/image/grub-efi.cfg
+++ b/target/linux/x86/image/grub-efi.cfg
@@ -3,7 +3,7 @@
 
 set default="0"
 set timeout="@TIMEOUT@"
-search -l kernel -s root
+search --no-floppy --set=root --fs-uuid 1234-ABCD
 
 menuentry "@TITLE@" {
 	linux /boot/vmlinuz @GPT_ROOTPART@ @CMDLINE@ noinitrd
