# OpenWrt's EFI/combined template locates the kernel with
#   search -l kernel -s root
# i.e. by FAT label, across every attached disk. Every disk written from the
# same image carries the label 'kernel', so whichever enumerates first supplies
# /boot/vmlinuz - a stick can boot the eMMC's kernel. Search by the boot
# partition's own filesystem UUID instead. 1234-ABCD is the serial mkfs.fat
# --invariant puts in every image built here.
#
# edge610-install deliberately leaves that serial alone: grub's core.img embeds
# it as a binary search hint, and rewriting the BPB drops the firmware at a bare
# "grub>" prompt. Two disks with the same image therefore share the serial; the
# kernel file may come from either, but root=PARTUUID is per-disk (the installer
# generates a fresh rootfs UUID), so the right root is still mounted.
diff --git a/target/linux/x86/image/grub-efi.cfg b/target/linux/x86/image/grub-efi.cfg
--- a/target/linux/x86/image/grub-efi.cfg
+++ b/target/linux/x86/image/grub-efi.cfg
@@ -3,7 +3,7 @@
 
 set default="0"
 set timeout="@TIMEOUT@"
-search -l kernel -s root
+search --no-floppy --set=root --fs-uuid 1234-ABCD
 
 menuentry "@TITLE@" {
 	linux /boot/vmlinuz @GPT_ROOTPART@ @CMDLINE@ noinitrd
