#!/bin/sh
# First-boot network for the Edge 610: LAN is the DSA port bridge
# (lan1..lan5 plus both SFP cages) at 192.168.1.1, WAN is lan6. The zzz prefix
# runs after every other uci-default (board.d eth0/eth1 defaults, ULA
# generation, dockerd) and before netifd starts (START=20).
#
# lan6 is the WAN port (DHCP client). The remaining five RJ45 ports and both
# SFP cages are LAN bridge members: lan1..lan5 are the DSA switch ports,
# eth2/eth3 are the two SFP cages on the second X553 controller
# (05:00.1 = the cage labelled SFP1, 05:00.0 = SFP2), eth0 is the switch
# conduit and must not be bridged, eth1 (03:00.1) is unused.
#
# board.d/99-default_network already created lan=br-lan with eth0 in it before
# this script runs, so "network.lan exists" cannot be used to detect a user
# configuration - a virgin install would then keep the generic x86 layout and
# the six RJ45 ports plus both cages would stay unbridged. Detect the pristine
# x86 default instead and edit only the sections this board owns, leaving
# interfaces added by other packages (docker, wwan) alone.

stamp=/etc/edge610-network-applied
[ -e "$stamp" ] && exit 0

# board.d writes either "option ipaddr 192.168.1.1" or the newer
# "list ipaddr '192.168.1.1/24'"; both are the factory default.
ipaddr="$(uci -q get network.lan.ipaddr)"
gateway="$(uci -q get network.lan.gateway)"
case "$ipaddr" in
""|192.168.1.1|192.168.1.1/24) ;;
*)
	logger -t edge610 "network already configured by the user, keeping it"
	touch "$stamp"
	exit 0
	;;
esac
if [ -n "$gateway" ]; then
	logger -t edge610 "network already configured by the user, keeping it"
	touch "$stamp"
	exit 0
fi

# br-lan bridge device section (created by board.d with eth0 as its only port).
brsec="$(uci -q show network | awk -F'[.=]' '/\.name=.br-lan.$/{print $2; exit}')"
if [ -z "$brsec" ]; then
	brsec="brlan"
	uci -q set network.$brsec='device'
	uci -q set network.$brsec.type='bridge'
	uci -q set network.$brsec.name='br-lan'
fi

uci -q delete network.$brsec.ports
for port in lan1 lan2 lan3 lan4 lan5 eth3 eth2; do
	uci -q add_list network.$brsec.ports="$port"
done

# LAN stays 192.168.1.1/24, it just moves onto the real port set.
uci -q set network.lan.device='br-lan'
uci -q set network.lan.proto='static'
uci -q set network.lan.ip6assign='60'

# lan6 as the WAN port, unless the user already has a wan interface.
if ! uci -q get network.wan >/dev/null 2>&1; then
	uci -q set network.wan='interface'
	uci -q set network.wan.device='lan6'
	uci -q set network.wan.proto='dhcp'
fi

uci -q commit network
touch "$stamp"

logger -t edge610 "first boot: br-lan=$(uci -q get network.$brsec.ports | tr ' ' ',') wan=$(uci -q get network.wan.device)"
exit 0
