#!/bin/sh
# First-boot network for the Edge 610: LAN is the DSA port bridge
# (lan1..lan6) at 192.168.1.1. The zzz prefix runs after every other
# uci-default (board.d eth0/eth1 defaults, ULA generation) and before
# netifd starts (START=20).
#
# No WAN is preconfigured on purpose: the box boots as a pure LAN switch
# (all six RJ45 ports plus both SFP cages are left for the user to assign).
# eth2/eth3 are the two ports of the second X553 controller (05:00.0/.1);
# eth0 is the switch conduit and eth1 (03:00.1) is unused.

# Keep an existing configuration: a sysupgrade that keeps /etc/config restores
# the user's interfaces, and rewriting them here would drop their addressing
# (this box is often deployed as a side router on a foreign subnet).
if uci -q get network.lan >/dev/null 2>&1; then
	logger -t edge610 "network already configured, keeping /etc/config/network"
	exit 0
fi

ula="$(uci -q get network.globals.ula_prefix)"

cat > /etc/config/network <<EOF
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
${ula:+	option ula_prefix '$ula'}

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'lan5'
	list ports 'lan6'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

EOF

exit 0
