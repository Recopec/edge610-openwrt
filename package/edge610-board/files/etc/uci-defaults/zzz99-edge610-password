#!/bin/sh
# Preset the root password so a freshly flashed box answers on SSH without
# anyone having to open the serial console first.
#
# Only a still-empty root password is touched: a keep-config sysupgrade
# restores the user's /etc/shadow, and rewriting that here would silently
# reset their password on every upgrade.
#
# sha256-crypt of edge610pass; change it with `passwd` and this script will
# never match again (it only fires while root's hash field is empty).

HASH='$5$UXYTFjf4hJEMNSzm$79ng8oKdGdM4htx6y8deGOAvj1FEmRovq6Cj8SwZJs/'

[ -f /etc/shadow ] || exit 0
grep -q '^root::' /etc/shadow || exit 0

sed -i "s|^root::|root:$HASH:|" /etc/shadow
logger -t edge610 "preset root password for the first login"
exit 0
