#!/bin/sh /etc/rc.common
# Re-dial wwan when the modem's PDP address drifts away from wwan0.

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/modem-wan-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
