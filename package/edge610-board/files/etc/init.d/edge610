#!/bin/sh /etc/rc.common
# Edge 610 board bring-up: hardware watchdog disable + X553 conduit,
# Marvell 88E6190 switch and DSA registration.
#
# Runs at START=19, before network (START=20). ixgbe autoload is removed
# from this image, so probe order is fully controlled here, following the
# CVMagic-validated sequence:
#   edge610_switch_standalone -> ixgbe -> edge610_dsa

START=19

log() {
	logger -t edge610 "$@" 2>/dev/null
	echo "edge610: $*"
}

is_edge610() {
	local d v dev
	for d in /sys/class/dmi/id/product_name /sys/class/dmi/id/board_name; do
		case "$(cat "$d" 2>/dev/null)" in
		*EDGE610*|*Edge610*|*edge610*|*VEP1400*) return 0 ;;
		esac
	done
	# Denverton P2SB 8086:19dd (CVMagic hardware presence check)
	for d in /sys/bus/pci/devices/*; do
		[ -f "$d/vendor" ] || continue
		v="$(cat "$d/vendor")"
		dev="$(cat "$d/device")"
		[ "$v" = "0x8086" ] && [ "$dev" = "0x19dd" ] && return 0
	done
	return 1
}

disable_watchdog() {
	local bus a addr ok=0
	modprobe i2c-ismt 2>/dev/null
	modprobe i2c-dev 2>/dev/null
	sleep 1
	bus=""
	for a in /sys/bus/i2c/devices/i2c-*; do
		[ -e "$a" ] || continue
		case "$(cat "$a/name" 2>/dev/null)" in
		*iSMT*|*ismt*) bus="${a##*/i2c-}"; break ;;
		esac
	done
	if [ -z "$bus" ]; then
		log "ERROR: iSMT SMBus adapter not found; hardware watchdog NOT disabled"
		return 1
	fi
	for addr in 0x22 0x24; do
		if i2cset -y "$bus" "$addr" 0x00 0x00 b 2>/dev/null; then
			ok=1
			log "watchdog: cleared register at $addr (bus $bus)"
		else
			log "watchdog: no response at $addr (bus $bus) - controller may be quiescent"
		fi
	done
	[ "$ok" = 1 ] && return 0
	log "ERROR: watchdog register write not confirmed"
	return 1
}

kofile() {
	local ko="/lib/modules/$(uname -r)/$1.ko"
	[ -f "$ko" ] && echo "$ko"
}

# insmod with parameters, idempotent: a second start() must not fail with
# EEXIST, and a module already loaded with the right parameters is fine.
load_module() {
	local name="$1" ko
	shift
	if [ -d "/sys/module/$name" ]; then
		log "$name already loaded; parameters: $(for f in /sys/module/$name/parameters/*; do printf '%s=%s ' "${f##*/}" "$(cat "$f" 2>/dev/null)"; done)"
		return 0
	fi
	ko="$(kofile "$name")"
	if [ -z "$ko" ]; then
		log "ERROR: $name.ko not found under /lib/modules/$(uname -r)"
		return 1
	fi
	insmod "$ko" "$@"
}

find_conduit() {
	local c tries n
	c=""
	if [ -d /sys/bus/pci/devices/0000:03:00.0/net ]; then
		tries=0
		while [ "$tries" -lt 50 ]; do
			c="$(ls /sys/bus/pci/devices/0000:03:00.0/net 2>/dev/null | head -n1)"
			[ -n "$c" ] && break
			tries=$((tries + 1))
			sleep 0.1
		done
	fi
	if [ -z "$c" ]; then
		# Fallback: the conduit carries the first of four consecutive
		# X553 MAC addresses (CVMagic), so pick the lowest-MAC ixgbe netdev.
		c="$(for n in /sys/class/net/*; do
			[ -e "$n/device/driver" ] || continue
			case "$(basename "$(readlink -f "$n/device/driver")")" in
			ixgbe) echo "$(cat "$n/address" 2>/dev/null) $(basename "$n")" ;;
			esac
		done | sort | head -n1 | awk '{print $2}')"
	fi
	echo "$c"
}

start() {
	local conduit p t

	if ! is_edge610; then
		log "not an Edge 610 (DMI/P2SB check failed); board bring-up skipped"
		return 0
	fi

	# Time-critical: PIC hardware watchdog reboots after 4-5 minutes.
	disable_watchdog || log "continuing despite watchdog failure"

	# Switch/X553 initializer MUST load before ixgbe probes.
	# NOTE: /sbin/modprobe is kmodloader, which silently drops name=value
	# arguments, so the modules are loaded with insmod and their parameters
	# are passed explicitly (verified on hardware: modprobe lost conduit_name).
	if ! load_module edge610_switch_standalone cpu_port=10 x553_sgmii=1 \
		cpu_mac_ctl=0x203e serdes_autoneg=1; then
		log "ERROR: edge610_switch_standalone failed to load"
		return 1
	fi
	if ! modprobe ixgbe; then
		log "ERROR: ixgbe failed to load"
		return 1
	fi

	conduit="$(find_conduit)"
	if [ -z "$conduit" ]; then
		log "ERROR: X553 conduit netdev not found"
		return 1
	fi
	log "conduit: $conduit"
	ip addr flush dev "$conduit" 2>/dev/null
	ip link set "$conduit" up

	if ! modprobe mv88e6xxx; then
		log "ERROR: mv88e6xxx failed to load"
		return 1
	fi
	if ! load_module edge610_dsa conduit_name="$conduit" force_cpu_phyctl=0x203e; then
		log "ERROR: edge610_dsa failed to load"
		return 1
	fi

	p=1
	while [ "$p" -le 6 ]; do
		t=0
		while [ ! -e "/sys/class/net/lan$p" ] && [ "$t" -lt 50 ]; do
			t=$((t + 1))
			sleep 0.1
		done
		if [ -e "/sys/class/net/lan$p" ]; then
			ip link set "lan$p" up
		else
			log "ERROR: port lan$p did not appear"
		fi
		p=$((p + 1))
	done
	log "up: $(ls -d /sys/class/net/lan[1-6] 2>/dev/null | sed 's|.*/||' | sort | tr '\n' ' ')"
	return 0
}
