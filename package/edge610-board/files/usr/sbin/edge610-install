#!/bin/sh
# edge610-install - put the running Edge 610 system onto the internal eMMC.
#
# Typical use: boot the USB stick image, run `edge610-install`, confirm, done.
# It copies the disk it booted from onto /dev/mmcblk0, grows the rootfs to the
# whole eMMC and gives the copy its own PARTUUID (so the stick and the eMMC do
# not collide at boot - see docs/bringup-log.md "PARTUUID 撞车").
#
#   edge610-install                          # clone the running stick to the eMMC
#   edge610-install edge610-*.img.gz         # write an image file instead
#   edge610-install --yes                    # unattended
#   edge610-install --target /dev/loop9 --from /dev/loop8 --yes   # testing
#
# Refuses to touch a disk that carries the running / or /boot.

set -eu

usage() {
	cat <<EOF
usage: edge610-install [--yes] [--target DEV] [--from DEV] [image.img.gz]

  (no image)     clone the disk this system booted from onto the target
  image.img.gz   write that image instead
  --yes          skip the confirmation prompt
  --target DEV   destination, default /dev/mmcblk0
  --from DEV     source disk for the clone, default = the running root disk
EOF
	exit 1
}

confirm=1
target=/dev/mmcblk0
src=
while [ $# -gt 0 ]; do
	case "$1" in
	--yes|-y) confirm=0; shift ;;
	--target) [ $# -ge 2 ] || usage; target=$2; shift 2 ;;
	--from)   [ $# -ge 2 ] || usage; src=$2; shift 2 ;;
	-h|--help) usage ;;
	-*) usage ;;
	*) break ;;
	esac
done
img=${1:-}

[ -b "$target" ] || { echo "$target is not a block device"; exit 1; }
target=$(readlink -f "$target")

part_of_disk() { # /dev/mmcblk0p2 -> /dev/mmcblk0, /dev/sdb2 -> /dev/sdb
	case "$(basename "$1")" in
	mmcblk*p[0-9]*) echo "/dev/$(basename "$1" | sed 's/p[0-9]*$//')" ;;
	mmcblk*)        echo "/dev/$(basename "$1")" ;;
	loop*p[0-9]*)   echo "/dev/$(basename "$1" | sed 's/p[0-9]*$//')" ;;
	nvme*p[0-9]*)   echo "/dev/$(basename "$1" | sed 's/p[0-9]*$//')" ;;
	*)              echo "/dev/$(basename "$1" | sed 's/[0-9]*$//')" ;;
	esac
}

mount_source() { # $1 = mount point -> the block device, or empty
	# /proc/mounts on OpenWrt reports the root as the synthetic /dev/root,
	# which has no device node; findmnt resolves it through sysfs.
	cur=$(findmnt -no SOURCE "$1" 2>/dev/null || true)
	[ -n "$cur" ] || cur=$(awk -v m="$1" '$2 == m {print $1; exit}' /proc/mounts)
	case "$cur" in
	/dev/root) cur=$(readlink -f /dev/root 2>/dev/null || true)
	           [ -b "$cur" ] || cur= ;;
	esac
	printf '%s' "$cur"
}

part_at_start() { # disk + start sector -> the partition node holding it
	sfdisk -d "$1" 2>/dev/null | awk -v dev="$1" -v s="$2" '
		$1 != dev && $1 ~ /^\/dev\// {
			start = ""
			for (i = 1; i <= NF; i++) if ($i == "start=") start = $(i + 1) + 0
			if (start == s) { sub(/,$/, "", $1); print $1; exit }
		}'
}

# --- the target must not be the disk we are running from -------------------
for mnt in / /boot; do
	cur=$(mount_source "$mnt")
	[ -n "$cur" ] || continue
	if [ "$(part_of_disk "$cur")" = "$target" ]; then
		echo "$target carries the running $mnt - run this from another disk (the USB image)"
		exit 1
	fi
done

# --- no partition of the target may be mounted -----------------------------
if awk -v b="$(basename "$target")" '$1 ~ b {print}' /proc/mounts | grep -q .; then
	echo "$target has mounted partitions - unmount them first:"
	awk -v b="$(basename "$target")" '$1 ~ b {print "  " $2}' /proc/mounts
	exit 1
fi

# --- work out how many sectors to write ------------------------------------
if [ -n "$img" ]; then
	[ -f "$img" ] || { echo "no such image: $img"; exit 1; }
	[ "$(dd if="$img" bs=2 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "1f8b" ] \
		|| { echo "$img is not gzip'ed - expected an .img.gz"; exit 1; }
	magic=$(gzip -dc "$img" | dd bs=2 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
	case "$magic" in
	eb63|eb48) ;;
	*) echo "unexpected boot sector 0x$magic - not an Edge 610 image"; exit 1 ;;
	esac
	bytes=$(gzip -dc "$img" | wc -c)
	sectors=$(( (bytes + 511) / 512 ))
	what="image $img"
else
	if [ -z "$src" ]; then
		root=$(mount_source /)
		[ -n "$root" ] || { echo "cannot resolve the root device (use --from DEV)"; exit 1; }
		src=$(part_of_disk "$root")
	fi
	src=$(readlink -f "$src")
	[ -b "$src" ] || { echo "cannot determine the source disk (use --from DEV)"; exit 1; }
	[ "$src" != "$target" ] || { echo "source and target are the same disk"; exit 1; }
	# highest partition end in sectors, plus the secondary GPT (33 sectors)
	# sfdisk -d prints "start=  <n>, size=  <n>, ..." - the value is the token
	# after the keyword, and "size" carries a trailing comma.
	sectors=$(sfdisk -d "$src" | awk -v d="$src" '
		index($1, d) == 1 && $1 != d {
			s = 0; z = 0
			for (i = 1; i <= NF; i++) {
				if ($i == "start=") s = $(i + 1) + 0
				if ($i == "size=")  z = $(i + 1) + 0
			}
			if (s + z > m) m = s + z
		}
		END { print m + 34 }')
	case "$sectors" in ''|0|*[!0-9]*) echo "cannot read the partition table of $src"; exit 1 ;; esac
	what="disk $src"
fi

# busybox blockdev has no --getsize64; sysfs always has the sector count.
tgt=$(blockdev --getsize64 "$target" 2>/dev/null || true)
case "$tgt" in
''|0|*[!0-9]*) tgt=$(( $(cat "/sys/class/block/$(basename "$target")/size") * 512 )) ;;
esac
[ "$tgt" -ge $((sectors * 512)) ] \
	|| { echo "target ($((tgt / 1024 / 1024)) MiB) is smaller than the source ($((sectors / 2048)) MiB)"; exit 1; }

echo "source: $what ($((sectors / 2048)) MiB)"
echo "target: $target ($((tgt / 1024 / 1024)) MiB)"

if [ "$confirm" = 1 ]; then
	printf 'Everything on %s will be erased. Type YES to continue: ' "$target"
	read -r ans
	[ "$ans" = "YES" ] || { echo "aborted"; exit 1; }
fi

# --- write ----------------------------------------------------------------
if [ -n "$img" ]; then
	echo "writing image..."
	gzip -dc "$img" | dd of="$target" bs=4M conv=fsync 2>/dev/null || { echo "write failed"; exit 1; }
else
	# When copying the live rootfs, make it read-only first so the copy is
	# consistent. A source given with --from is left alone.
	ro_restore=
	live=$(part_of_disk "$(mount_source /)")
	if [ "$src" = "$live" ]; then
		if ! awk '$2 == "/" && $4 ~ /(^|,)ro(,|$)/ {found = 1} END {exit !found}' /proc/mounts; then
			if mount -o remount,ro / 2>/dev/null; then
				ro_restore=1
			else
				echo "WARNING: cannot remount / read-only; relying on e2fsck afterwards"
			fi
		fi
	fi
	echo "cloning $src -> $target ..."
	sync        # the source is live; get as much of it on disk as possible
	dd if="$src" of="$target" bs=4M count=$((sectors / 8192 + 1)) conv=fsync 2>/dev/null \
		|| { echo "write failed"; [ -n "$ro_restore" ] && mount -o remount,rw /; exit 1; }
	[ -n "$ro_restore" ] && mount -o remount,rw / || true
fi
sync

partx -d - "$target" >/dev/null 2>&1 || true

# --- give the copy a table that describes this disk -----------------------
# A clone carries the source's GPT, backup table included. When the target is
# smaller than the source that backup lands past the end, so the kernel
# rejects the table and falls back to the protective MBR: no partitions, no
# ${target}p2. Write the image's layout instead - 512..262655 boot (legacy
# bootable), 262656..end rootfs - and let sfdisk generate fresh disk and
# partition GUIDs so the copy cannot collide with its source.
#
# No BIOS boot partition here, on purpose. The image carries one at 34..511
# (p128) but the partition *numbers* matter to grub: its core.img is built for
# the boot filesystem on gpt1, so any layout that pushes the FAT to gpt2 drops
# the firmware at a bare "grub>" prompt. sfdisk numbers partitions in start
# order, so keeping the FAT at 512 makes it p1, exactly like the image.
#
# core.img itself still sits at 34..511 in the unallocated gap: boot.img loads
# it from that absolute sector, not through a partition. Measured on the
# device - boots unattended with this table.
sectors_total=$(cat "/sys/class/block/$(basename "$target")/size")
[ "$sectors_total" -gt 262656 ] || { echo "$target is too small"; exit 1; }
echo "rewriting the partition table for $target..."
{
	echo "label: gpt"
	echo "first-lba: 34"
	echo "start=512, size=262144, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, attrs=LegacyBIOSBootable"
	echo "start=262656, size=$((sectors_total - 34 - 262656)), type=0FC63DAF-8483-4772-8E79-3D69D8477DE4"
} | sfdisk --force --no-reread "$target" >/dev/null 2>&1 \
	|| { echo "sfdisk could not write the partition table"; exit 1; }
partx -a "$target" >/dev/null 2>&1 || true
sleep 1

# Resolve the two partitions by start sector rather than by number: the table
# above is what guarantees the order, but the installer should not depend on a
# numbering the image does not share (p128 there, absent here).
p1=$(part_at_start "$target" 512)      # boot: FAT with grub.cfg
p2=$(part_at_start "$target" 262656)   # rootfs
[ -b "$p2" ] || { echo "cannot find the rootfs partition after the write"; exit 1; }
[ -b "$p1" ] || { echo "cannot find the boot partition after the write"; exit 1; }

# --- repair and grow ------------------------------------------------------
# The clone was taken from a live filesystem (busybox cannot always remount /
# read-only while the stick is in use), so fsck it before it is ever mounted.
echo "checking and growing the rootfs..."
e2fsck -fy "$p2" >/dev/null 2>&1 || true
resize2fs "$p2" >/dev/null 2>&1 \
	&& echo "rootfs grown to $(( $(cat "/sys/class/block/$(basename "$p2")/size") / 2048 )) MiB" \
	|| echo "WARNING: resize2fs failed; run: resize2fs $p2"

# --- point the boot config at this copy's rootfs --------------------------
# The rootfs PARTUUID is fresh (the table was rewritten above), so grub.cfg
# has to follow or it would mount the source disk's /.
#
# The FAT serial is deliberately left alone. grub's core.img carries the boot
# filesystem's uuid as a binary search hint; renaming the volume means patching
# a four-byte value inside a packed binary, and a hint that no longer matches
# drops the firmware at a bare "grub>" prompt with no menu (observed). Keeping
# the serial means an eMMC-only boot resolves the hint exactly like the stick
# did. Two disks with the same serial only matter when both are attached - the
# development case that scripts/usb-prep.sh exists for.
gpt_uuid() { sfdisk -d "$1" 2>/dev/null | grep "^$2 " \
	| sed -n 's/.*uuid=\([0-9A-Fa-f-]*\).*/\1/p'; }

root_uuid=$(gpt_uuid "$target" "$p2")
[ -n "$root_uuid" ] || echo "WARNING: cannot read the UUID of $p2"
echo "root partition UUID: ${root_uuid:-unknown}"

mnt=$(mktemp -d)
if mount "$p1" "$mnt" 2>/dev/null; then
	cfg=""
	for c in "$mnt/boot/grub/grub.cfg" "$mnt/grub/grub.cfg"; do
		[ -f "$c" ] && cfg=$c && break
	done
	if [ -n "$cfg" ] && [ -n "$root_uuid" ]; then
		low=$(echo "$root_uuid" | tr 'A-F' 'a-f')
		sed -i -E "s|root=PARTUUID=[0-9A-Fa-f-]+|root=PARTUUID=$low|Ig" "$cfg"
		grep -q "root=PARTUUID=$low" "$cfg" \
			&& echo "grub.cfg root= -> $low" \
			|| echo "WARNING: grub.cfg root= not updated"
	fi
	sync
	umount "$mnt"
fi
rmdir "$mnt" 2>/dev/null || true

echo
echo "done. power off, remove the USB stick, boot from $target."
