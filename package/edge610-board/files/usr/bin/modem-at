#!/bin/sh
# Send one AT command to the Edge 610's Sierra EM7565 and print the reply.
# The AT port is discovered once (ttyUSB* that answers "AT") and cached in
# /tmp/.modem-at-port.
#
# Usage: modem-at [-p] <AT command>
#   -p  unlock password-protected commands first (AT!ENTERCND)
TIMEOUT=3
if [ "$1" = "-t" ]; then
	TIMEOUT="$2"
	shift 2
fi
CMD="$1"
[ -n "$CMD" ] || exit 1
PW=
if [ "$CMD" = "-p" ]; then
	PW=1
	CMD="$2"
	[ -n "$CMD" ] || exit 1
fi

PORTFILE=/tmp/.modem-at-port

find_port() {
	local p
	if [ -s "$PORTFILE" ]; then
		p="$(cat "$PORTFILE")"
		[ -c "$p" ] && { echo "$p"; return 0; }
	fi
	for p in /dev/ttyUSB*; do
		[ -c "$p" ] || continue
		case "$(printf 'AT\r' | timeout 2 socat - "$p",raw,echo=0 2>/dev/null)" in
			*OK*) echo "$p" > "$PORTFILE"; echo "$p"; return 0 ;;
		esac
	done
	return 1
}

P="$(find_port)" || { echo "AT port not found"; exit 1; }

LINGER=
[ "$TIMEOUT" -gt 3 ] && LINGER="-t $TIMEOUT"

if [ -n "$PW" ]; then
	{ printf 'AT!ENTERCND="A710"\r'; sleep 1; printf '%s\r' "$CMD"; } | \
		timeout "$((TIMEOUT + 2))" flock -w 10 /tmp/.modem-at.lock socat $LINGER - "$P",raw,echo=0 2>/dev/null
else
	printf '%s\r' "$CMD" | timeout "$TIMEOUT" flock -w 10 /tmp/.modem-at.lock socat $LINGER - "$P",raw,echo=0 2>/dev/null
fi
